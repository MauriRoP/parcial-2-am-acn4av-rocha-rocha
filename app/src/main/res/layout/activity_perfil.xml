<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi Perfil"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtEmailPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usuario: cargando..."
        android:textSize="15sp"
        android:textColor="#455A64"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis Contratos y Solicitudes Activas"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/layoutContenedorContratos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEstadoCarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consultando contratos en la nube..."
                android:textSize="15sp"
                android:textColor="#78909C" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnVolverCatalogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VOLVER AL CATÁLOGO"
        android:backgroundTint="#1565C0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CERRAR SESIÓN"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF" />

</LinearLayout>